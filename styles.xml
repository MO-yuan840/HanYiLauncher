<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="XuanZhi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 全局宋体：思源宋体，没带字体文件时自动降级 Noto Serif CJK -->
        <item name="android:fontFamily">@font/xuanzhi_font</item>
        <item name="fontFamily">@font/xuanzhi_font</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/xz_paper</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>

        <!-- 控件基调：墨字、金线、无阴影 -->
        <item name="colorPrimary">@color/xz_ink</item>
        <item name="colorPrimaryDark">@color/xz_ink_soft</item>
        <item name="colorAccent">@color/xz_vermilion</item>
        <item name="colorControlNormal">@color/xz_gilt</item>
        <item name="colorControlActivated">@color/xz_vermilion</item>
        <item name="android:textColorPrimary">@color/xz_ink</item>
        <item name="android:textColorSecondary">@color/xz_ink_soft</item>
        <item name="android:windowBackground">@drawable/xz_window_bg</item>
    </style>

    <!-- 标题：大字疏朗，字距放宽，像匾额 -->
    <style name="XuanZhi.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_ink</item>
    </style>

    <!-- 小字：注释、版本号，淡墨 -->
    <style name="XuanZhi.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/xz_ink_soft</item>
    </style>

    <!-- 按钮文字：不粗，靠印泥色承重 -->
    <style name="XuanZhi.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/xz_paper</item>
    </style>
    <!-- 分区小标题：像卷边题签 -->
    <style name="XuanZhi.Section">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/xz_gilt</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="XuanZhi.Card" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/xz_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/xz_surface_rim</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
    <style name="Widget.XuanZhi.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/xz_gilt</item>
        <item name="strokeColor">@color/xz_gilt_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>
</resources>
