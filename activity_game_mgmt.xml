<?xml version="1.0" encoding="utf-8"?>
<net.hanyi.launcher.ui.window.LatticeFrame
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    app:lattice_inset="12dp" app:lattice_color="@color/xz_gilt_soft" app:lattice_thickness="0.6dp">

    <net.hanyi.launcher.ui.window.XuanZhiBackground
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">

        <TextView style="@style/XuanZhi.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:text="@string/mgmt_title" />

        <TextView style="@style/XuanZhi.Caption"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="@string/mgmt_hint" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:tabIndicatorColor="@color/xz_vermilion"
            app:tabSelectedTextColor="@color/xz_ink"
            app:tabTextColor="@color/xz_ink_soft"
            app:tabMode="fixed" app:tabGravity="fill"
            app:tabBackground="@drawable/xz_card" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="3"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add"
                style="@style/Widget.XuanZhi.Button.Outlined"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:text="@string/mgmt_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                style="@style/Widget.XuanZhi.Button.Outlined"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:text="@string/mgmt_refresh" />
        </LinearLayout>

        <TextView android:id="@+id/tv_scan"
            style="@style/XuanZhi.Caption"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="6dp"
            android:scrollbars="vertical" />

        <TextView android:id="@+id/tv_empty"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/xz_ink_soft" android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</net.hanyi.launcher.ui.window.LatticeFrame>
