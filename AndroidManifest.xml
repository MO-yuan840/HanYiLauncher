<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：拉版本清单、下 jar/assets、走微软 OAuth -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 外部存储：游戏目录默认放在内部存储的 XuanZhi/，不需要危险权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 必须声明支持 x86 以外的 abi，否则 64 位 JVM .so 不加载 -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/XuanZhi"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".ui.LaunchActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AuthActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".ui.VersionListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ConsoleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- JRE 解压后的 lib 目录，让 dlopen 能找到依赖链（libjvm->libjava->libverify…） -->
        <meta-data
            android:name="net.hanyi.launcher.jre_lib_dir"
            android:value="jre/lib/aarch64" />
            <service
            android:name=".controls.TouchOverlayService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_touch" />
        </service>
    </application>
</manifest>

        <!-- 触控/鼠标预设/皮肤 + 游戏管理 + 网站与种子库 -->
        <activity android:name=".ui.TouchConfigActivity" android:exported="false" />
        <activity android:name=".ui.GameMgmtActivity" android:exported="false" />
        <activity android:name=".ui.WebSitesActivity" android:exported="false" />
