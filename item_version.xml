<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginVertical="4dp" android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="10dp" app:cardBackgroundColor="#1A1A24"
    app:cardElevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:orientation="horizontal" android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/v_name"
            android:text="1.21.5" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
        <TextView android:id="@+id/v_type"
            android:text="release" android:textColor="#8BC34A" android:textSize="11sp"
            android:background="#223322" android:padding="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
